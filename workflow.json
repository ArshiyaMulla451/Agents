    {
      "parameters": {
        "jsCode": "const output = $json.output || \"\";\n\nconst html = `\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<title>Shopping Advisor Recommendation</title>\n</head>\n\n<body style=\"margin:0; padding:0; background-color:#f4f6f8; font-family:Arial, Helvetica, sans-serif;\">\n\n<div style=\"max-width:700px; margin:30px auto; background:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 4px 15px rgba(0,0,0,0.1);\">\n\n    <!-- Header -->\n    <div style=\"background:#4f46e5; padding:30px; text-align:center; color:white;\">\n        <h1 style=\"margin:0; font-size:28px;\">\n            🛍️ Shopping Advisor\n        </h1>\n        <p style=\"margin:10px 0 0; font-size:16px;\">\n            Your Personalized Product Recommendations\n        </p>\n    </div>\n\n    <!-- Content -->\n    <div style=\"padding:30px;\">\n\n        <h2 style=\"color:#333333; margin-top:0;\">\n            ✨ Your Product Recommendations\n        </h2>\n\n        <div style=\"\n            background:#f8f9ff;\n            border-left:5px solid #4f46e5;\n            padding:20px;\n            border-radius:8px;\n            color:#333333;\n            font-size:15px;\n            line-height:1.7;\n            white-space:pre-line;\n        \">\n            ${output}\n        </div>\n\n    </div>\n\n    <!-- Footer -->\n    <div style=\"background:#f4f6f8; padding:20px; text-align:center; color:#777777; font-size:13px;\">\n        <p style=\"margin:0;\">\n            This recommendation was generated by your AI Shopping Advisor.\n        </p>\n        <p style=\"margin:8px 0 0;\">\n            Powered by AI 🤖\n        </p>\n    </div>\n\n</div>\n\n</body>\n</html>\n`;\n\nreturn [\n  {\n    json: {\n      html: html\n    }\n  }\n];"
      },
