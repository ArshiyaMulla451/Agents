    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a Shopping Requirement Extraction Agent.\n\nYour job is to analyze the user's shopping request and extract the exact search requirements.\n\nReturn ONLY valid JSON. Do not recommend any products.\n\nUse this exact format:\n\n{\n  \"category\": \"\",\n  \"maxPrice\": null,\n  \"minPrice\": null,\n  \"minRating\": null,\n  \"minDiscount\": null,\n  \"brand\": \"\",\n  \"keywords\": []\n}\n\nRules:\n\n1. Extract the product category.\n2. If the user says \"perfume\" or \"perfumes\", set category to \"fragrances\".\n3. If the user says \"fragrance\" or \"fragrances\", set category to \"fragrances\".\n4. If the user says \"beauty\", set category to \"beauty\".\n5. If the user says \"under $200\", set maxPrice to 200.\n6. If the user says \"below $200\", set maxPrice to 200.\n7. If the user says \"less than $200\", set maxPrice to 200.\n8. If the user says \"above $50\", set minPrice to 50.\n9. If the user says \"rating above 4\", set minRating to 4.\n10. If the user says \"rating 4 or higher\", set minRating to 4.\n11. If the user specifies a discount, set minDiscount accordingly.\n12. If the user specifies a brand, extract the brand.\n13. Put additional product requirements in keywords.\n14. If a requirement is not mentioned, use null for numbers and an empty string for text.\n15. Do not invent requirements.\n16. Do not recommend products.\n17. Return JSON only.\n\nUser request:\n{{ $json.chatInput }}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        208,
        0
      ],
      "id": "46a989d1-618c-4f3c-b635-be8b060c484f",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
